# Hide Shell and Batch scripts from GitHub language stats
*.sh linguist-detectable=false
*.bat linguist-detectable=false

# Ignore generated assets or config files
package-lock.json linguist-generated=true
Cargo.lock linguist-generated=true

# Hide graphify-out HTML from language stats
graphify-out/** linguist-generated=true

# Hide CSS from language stats
*.css linguist-detectable=false
